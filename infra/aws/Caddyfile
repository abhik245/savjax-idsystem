{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# Brotli first, then zstd, then gzip — best compression ratio
	encode {
		zstd
		gzip
		minimum_length 1024
	}

	# Long-lived immutable cache for Next.js versioned static chunks
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	header @static X-Cache "HIT-STATIC"

	# Short cache for public static files
	@public path /favicon.ico /robots.txt *.png *.jpg *.jpeg *.svg *.webp *.woff2
	header @public Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# Long cache for the vendored MediaPipe WASM runtime + model — these are
	# large (~38MB) and immutable per deploy; schools have unreliable
	# connectivity so avoid re-fetching them every visit.
	@mediapipe path /mediapipe/*
	header @mediapipe Cache-Control "public, max-age=604800, stale-while-revalidate=2592000"

	reverse_proxy web:3000
}

{$API_DOMAIN} {
	encode {
		zstd
		gzip
		minimum_length 1024
	}
	reverse_proxy api:4000
}
